# =========================================================
#  Copy to .env (repo root). Every app and package reads it.
# =========================================================
NODE_ENV=development

# ---------- Database (PostgreSQL) ----------
DATABASE_URL=postgresql://ecommerce:ecommerce@localhost:5432/ecommerce?schema=public

# ---------- Redis (cache + BullMQ queues) ----------
REDIS_URL=redis://localhost:6379

# ---------- API ----------
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Email (the only notification channel) ----------
# Local dev uses Mailpit (docker compose): inbox at http://localhost:8025
MAIL_PROVIDER=smtp
MAIL_FROM="Ecommerce <no-reply@example.com>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ---------- Object storage (S3-compatible; MinIO locally) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ecommerce-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
CDN_URL=http://localhost:9000/ecommerce-media

# ---------- Payments ----------
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# ---------- Frontend apps ----------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_VENDOR_URL=http://localhost:3002

# ---------- Seed ----------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345
