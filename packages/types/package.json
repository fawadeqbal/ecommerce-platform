{
  "name": "@ecommerce/types",
  "version": "0.0.0",
  "private": true,
  "description": "Shared enums, constants and API contracts (no runtime deps)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "clean": "rimraf dist .turbo"
  },
  "devDependencies": {
    "@ecommerce/config": "workspace:*",
    "typescript": "^5.7.3",
    "eslint": "^9.18.0",
    "rimraf": "^6.0.1"
  }
}
